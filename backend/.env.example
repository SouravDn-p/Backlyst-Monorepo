# ==============================================================================
# Backlyst Backend - Local Development Environment Variables
# Copy this file to `.env` for local development
# ==============================================================================

# ─── Database (Local PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backlyst_db?schema=public"

# ─── Redis & BullMQ (Local Redis) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
BULLMQ_PREFIX="backlyst"

# ─── Application ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
JWT_SECRET="local-development-secret-jwt-key-change-in-production-12345"

# ─── Storage (Local MinIO S3-compatible) ───────────────────────────────────────
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="backlyst-storage"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_PUBLIC_ENDPOINT="http://localhost:9000"
AWS_S3_FORCE_PATH_STYLE="true"
AWS_S3_SIGNED_URL_EXPIRY="86400"

# ─── Frontend & Client URLs ──────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"
CLIENT_URL="http://localhost:3000"

# ─── SMTP (AWS SES) ───────────────────────────────────────────────────────────
SMTP_HOST="email-smtp.eu-west-2.amazonaws.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Backlyst <contact@backlyst.co.uk>"

# ─── Stripe (Optional for local testing) ───────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TASK_CREDIT_SINGLE_PRICE_ID=""
STRIPE_TASK_CREDIT_BUNDLE_5_PRICE_ID=""

# ─── Google OAuth (Optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"
