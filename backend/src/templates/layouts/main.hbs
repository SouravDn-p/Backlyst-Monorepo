<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #667eea, #764ba2);
        min-height: 100vh;
      }

      .container {
        max-width: 700px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.16);
      }

      .header {
        background: #3b82f6;
        color: #ffffff;
        padding: 24px;
        font-size: 22px;
        font-weight: 700;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
      }

      .header-logo {
        max-height: 40px;
        max-width: 40px;
      }

      .greeting {
        font-size: 18px;
        margin-bottom: 20px;
        color: #1f2937;
      }

      .main-content {
        margin-bottom: 30px;
      }

      .cta {
        text-align: center;
        margin: 30px 0;
      }

      .cta-button {
        display: inline-block;
        padding: 12px 24px;
        background: linear-gradient(90deg, #3b82f6, #6366f1);
        color: #ffffff;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        margin: 10px 0;
      }

      .signature {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
      }

      .body {
        padding: 32px;
        color: #1f2937;
        line-height: 1.7;
      }

      .footer {
        background: #f4f6f8;
        text-align: center;
        padding: 18px;
        font-size: 13px;
        color: #6b7280;
      }

      .content-title {
        font-size: 22px;
        margin: 0 0 16px;
        color: #111827;
        font-weight: 700;
      }

      .content-copy {
        margin: 16px 0;
        color: #374151;
      }

      .otp-box {
        display: inline-block;
        padding: 16px 26px;
        margin: 20px 0;
        font-size: 28px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(90deg, #3b82f6, #6366f1);
        border-radius: 10px;
        letter-spacing: 4px;
      }

      .message-box {
        margin-top: 20px;
        padding: 20px;
        background: #f8fafc;
        border-radius: 10px;
        line-height: 1.7;
        white-space: pre-wrap;
        border: 1px solid #e5e7eb;
      }

      .row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
        color: #1f2937;
      }

      .label {
        font-weight: 700;
        color: #111827;
        min-width: 110px;
      }

      .link {
        color: #2563eb;
        text-decoration: none;
      }

      .link:hover {
        text-decoration: underline;
      }

      .center {
        text-align: center;
      }

      .mt-8 {
        margin-top: 8px;
      }

      .mt-16 {
        margin-top: 16px;
      }

      .mt-20 {
        margin-top: 20px;
      }

      .mt-24 {
        margin-top: 24px;
      }

      .mt-25 {
        margin-top: 25px;
      }

      .mt-28 {
        margin-top: 28px;
      }

      .mt-30 {
        margin-top: 30px;
      }

      .mt-32 {
        margin-top: 32px;
      }

      .mb-8 {
        margin-bottom: 8px;
      }

      .mb-10 {
        margin-bottom: 10px;
      }

      .mb-14 {
        margin-bottom: 14px;
      }

      .mb-16 {
        margin-bottom: 16px;
      }

      .mb-20 {
        margin-bottom: 20px;
      }

      .text-sm {
        font-size: 13px;
        color: #6b7280;
      }

      .text-gray {
        color: #6b7280;
      }

      .text-dark {
        color: #111827;
      }

      .font-bold {
        font-weight: 700;
      }

      .pre-wrap {
        white-space: pre-wrap;
      }

      .border {
        border: 1px solid #e5e7eb;
      }

      .bg-light {
        background: #f8fafc;
      }

      .p-20 {
        padding: 20px;
      }

      .rounded {
        border-radius: 10px;
      }

      .flex {
        display: flex;
      }

      .flex-wrap {
        flex-wrap: wrap;
      }

      .gap-8 {
        gap: 8px;
      }

      .min-w-110 {
        min-width: 110px;
      }

      @media (max-width: 600px) {
        .container {
          margin: 20px;
        }

        .header {
          font-size: 20px;
          padding: 20px 18px;
        }

        .body {
          padding: 22px 18px;
        }

        .content-title {
          font-size: 20px;
        }
      }
    </style>
  </head>

  <body>
    {{#if plainEmail}}
      <div style='max-width: 700px; margin: 0 auto; padding: 24px; color: #111111; background: #ffffff; font-family: Arial, sans-serif; line-height: 1.6;'>
        {{{body}}}
        <p style='margin: 24px 0 0; color: #111111;'>
          &copy; {{year}} {{companyName}}. All rights reserved.
        </p>
      </div>
    {{else}}
      <div class='container'>

        <div class='header'>
          {{#if logoUrl}}
            <img src='{{logoUrl}}' alt='{{companyName}} Logo' class='header-logo' />
          {{/if}}
          {{headerTitle}}
        </div>

        <div class='body'>
          {{#if greeting}}
            <div class='greeting'>{{{greeting}}}</div>
          {{/if}}

          <div class='main-content'>
            {{{body}}}
          </div>

          {{#if cta}}
            <div class='cta'>{{{cta}}}</div>
          {{/if}}

          {{#if signature}}
            <div class='signature'>{{{signature}}}</div>
          {{/if}}
        </div>

        <div class='footer'>
          {{#if footerMessage}}
            <p>{{footerMessage}}</p>
          {{/if}}
          &copy; {{year}} {{companyName}}. All rights reserved.
        </div>

      </div>
    {{/if}}
  </body>
</html>
