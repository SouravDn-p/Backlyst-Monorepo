  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryKey, scope])
  @@index([isActive])
}

model GeographicDistributionCap {
  id           String  @id @default(cuid())
  countryCode  String // e.g. "US", "UK"
  scope        String  @default("PRIMARY")
  maxPerWindow Int
  windowDays   Int     @default(7)
  isActive     Boolean @default(true)
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, scope])
  @@index([isActive])
}

model OpportunityTypeDistributionCap {
  id            String  @id @default(cuid())
  placementType String
  scope         String  @default("PRIMARY")
  maxPerWindow  Int
  windowDays    Int     @default(7)
  isActive      Boolean @default(true)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placementType, scope])
  @@index([isActive])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum RiskEventType {
  DISPUTE
  REJECTION
  FAILURE
  ABUSE
  SUCCESS
}

enum PatternFlagType {
  CLUSTER_CONCENTRATION
  RECIPROCAL_RING
  REPEAT_BURST
}

enum PatternSeverity {
  LOW
  MEDIUM
  HIGH
}

enum PatternFlagStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MarketplaceMode {
  EARLY_STAGE
  SCALING
}

model Dispute {
  id                 String        @id @default(cuid())
  taskId             String
  requesterWebsiteId String
  providerWebsiteId  String
  openedById         String
  resolvedById       String?
  status             DisputeStatus @default(OPEN)
  reason             String
  evidence           Json?
  creditAdjustmentId String?       @unique
  creditAdjustment   CreditLog?    @relation("DisputeCreditAdjustment", fields: [creditAdjustmentId], references: [id], onDelete: SetNull)
  openedAt           DateTime      @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([taskId])
  @@index([status])
  @@index([requesterWebsiteId])
  @@index([providerWebsiteId])
  @@index([creditAdjustmentId])
}

model RiskEvent {
  id             String        @id @default(cuid())
  websiteId      String
  type           RiskEventType
  delta          Float
  riskScoreAfter Float
  createdAt      DateTime      @default(now())

  website Website @relation("WebsiteRiskEvents", fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([type])
  @@index([websiteId, type])
}

model PatternFlag {
  id            String            @id @default(cuid())
  type          PatternFlagType
  severity      PatternSeverity   @default(MEDIUM)
  status        PatternFlagStatus @default(OPEN)
  windowStart   DateTime
  windowEnd     DateTime
  domainCount   Int
  memberDomains String[]
  evidenceJson  Json?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([windowEnd])
}

model MarketplaceModeConfig {
  id          String          @id @default("MARKETPLACE_MODE_CONFIG")
  mode        MarketplaceMode @default(EARLY_STAGE)
  isActive    Boolean         @default(true)
  preset      Json?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ManualMatchQueue {
  id                 String    @id @default(cuid())
  taskId             String
  providerWebsiteId  String
  requesterWebsiteId String
  status             String    @default("PENDING")
  createdById        String
  note               String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  task             PlacementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  providerWebsite  Website       @relation("ManualMatchProviderWebsite", fields: [providerWebsiteId], references: [id], onDelete: Cascade)
  requesterWebsite Website       @relation("ManualMatchRequesterWebsite", fields: [requesterWebsiteId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([providerWebsiteId])
  @@index([requesterWebsiteId])
  @@index([status])
}

model QualityRubric {
  id String @id @default(cuid())

  taskId String @unique

  providerWebsiteId  String
  requesterWebsiteId String

  contentRelevance    Int
  technicalQuality    Int
  communication       Int
  timeliness          Int
  overallSatisfaction Int

  compositeScore Float

  comments String?

  createdAt DateTime @default(now())

  @@index([providerWebsiteId])
  @@index([requesterWebsiteId])
}

model BehaviourPattern {
  id String @id @default(cuid())

  websiteId String

  patternType BehaviourPatternType
  severity    BehaviourPatternSeverity @default(MEDIUM)
  score       Float                    @default(0)
  windowStart DateTime
  windowEnd   DateTime

  evidenceJson Json?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation("WebsiteBehaviourPatterns", fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, windowEnd])
  @@index([patternType])
  @@index([severity])
  @@index([resolvedAt])
}

model WebsiteQualityStatusLog {
  id String @id @default(cuid())

  websiteId String

  previousStatus WebsiteMarketplaceStatus
  newStatus      WebsiteMarketplaceStatus

  previousScore Float
  newScore      Float

  trigger QualityStatusTrigger

  adminId    String?
  reasonCode String?
  note       String?

