  website Website @relation("WebsiteQualityStatusLogs", fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([trigger])
  @@index([newStatus])
}

model RankingRunLog {
  id               String   @id @default(cuid())
  providerId       String
  candidatesIn     Int
  candidatesOut    Int
  marketplaceMode  String
  lowPoolActive    Boolean  @default(false)
  processingTimeMs Int
  topScores        Json?
