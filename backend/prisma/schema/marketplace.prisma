  @@index([providerId, createdAt])
  @@index([marketplaceMode])
  @@index([createdAt])
}

model VisibilityAdjustmentLog {
  id String @id @default(cuid())

  rankingRunLogId String?

  providerId String
  taskId     String
  websiteId  String

  adjustmentType String

  beforeScore Float
  afterScore  Float

  factor            Float?
  marketplaceStatus String?
  reasonCode        String

  marketplaceMode String   @default("NORMAL")
  createdAt       DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([websiteId, createdAt])
  @@index([taskId, createdAt])
  @@index([rankingRunLogId])
  @@index([adjustmentType])
}

model QualityScoreHistory {
  id String @id @default(cuid())

  websiteId String

  qualityScore     Float
  completionScore  Float?
  reliabilityScore Float?
  ratingScore      Float?
  activityScore    Float?
  consistencyScore Float?
  diversityScore   Float?
  behaviourScore   Float?
  riskScore        Float?

  marketplaceStatus WebsiteMarketplaceStatus

  trigger QualityStatusTrigger

  createdAt DateTime @default(now())

  website Website @relation("WebsiteQualityScoreHistory", fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([createdAt])
}

model PublicSuffixList {
  id        String   @id @default(cuid())
  suffix    String   @unique
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ---- Taxonomy Foundation (Phase 2) ----

model MarketplaceCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  enabled   Boolean  @default(true)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MarketplaceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children MarketplaceCategory[] @relation("CategoryHierarchy")

  relatedFrom MarketplaceCategoryRelation[] @relation("CategoryRelationSource")
  relatedTo   MarketplaceCategoryRelation[] @relation("CategoryRelationTarget")

  websites WebsiteMarketplaceCategory[]
  tasks    TaskMarketplaceCategory[]

  @@index([enabled])
  @@index([parentId])
}

model MarketplaceCategoryRelation {
  id               String   @id @default(uuid())
  sourceId         String
  targetId         String
  relationshipType String
  weight           Float    @default(1.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  source MarketplaceCategory @relation("CategoryRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target MarketplaceCategory @relation("CategoryRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model MarketplaceTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websites WebsiteMarketplaceTag[]
  tasks    TaskMarketplaceTag[]

  @@index([enabled])
}

model WebsiteMarketplaceCategory {
  id         String                  @id @default(uuid())
  websiteId  String
  categoryId String
  role       MarketplaceCategoryRole @default(PRIMARY)
  createdAt  DateTime                @default(now())

  website  Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([websiteId, categoryId])
  @@index([websiteId])
  @@index([categoryId])
}

model WebsiteMarketplaceTag {
  id        String   @id @default(uuid())
  websiteId String
  tagId     String
  createdAt DateTime @default(now())

  website Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tag     MarketplaceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([websiteId, tagId])
  @@index([websiteId])
  @@index([tagId])
}

model TaskMarketplaceCategory {
  id         String                  @id @default(uuid())
  taskId     String
  categoryId String
  role       MarketplaceCategoryRole @default(PRIMARY)
  createdAt  DateTime                @default(now())

  task     PlacementTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([taskId, categoryId])
  @@index([taskId])
  @@index([categoryId])
}

model TaskMarketplaceTag {
  id        String   @id @default(uuid())
  taskId    String
  tagId     String
  createdAt DateTime @default(now())

  task PlacementTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  MarketplaceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}
