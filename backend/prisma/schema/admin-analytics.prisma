enum AdminAnalyticsReportType {
  WEBSITES_TASKS_SUMMARY
  CREDIT_USAGE_SUMMARY
  DAILY_PLATFORM_ACTIVITY
  FOLLOW_NOFOLLOW_LINKS
  USER_RETENTION_GROWTH
  TASK_LIFECYCLE_RISK
  PROVIDER_PERFORMANCE
  GOVERNANCE_RISK
  FULL_PLATFORM_SUMMARY
}

enum AdminAnalyticsReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum AdminAnalyticsReportStatus {
  READY
  FAILED
}

model AdminAnalyticsReport {
  id              String                     @id @default(uuid())
  reportCode      String                     @unique
  name            String
  description     String?
  reportType      AdminAnalyticsReportType
  period          AdminAnalyticsReportPeriod
  dateFrom        DateTime
  dateTo          DateTime
  participant     String                     @default("ALL")
  filters         Json?
  snapshot        Json
  snapshotVersion Int                        @default(1)
  totalRecords    Int                        @default(0)
  status          AdminAnalyticsReportStatus @default(READY)
  errorMessage    String?
  generatedById   String
  generatedAt     DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?

  generatedBy User @relation("AdminGeneratedAnalyticsReports", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([reportType, generatedAt])
  @@index([generatedById, generatedAt])
  @@index([status, generatedAt])
  @@index([deletedAt])
}
