model ContactEnquiry {
  id      String  @id @default(uuid())
  name    String
  company String?
  email   String
  phone   String?
  subject String?
  message String

  isRead Boolean       @default(false)
  status EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isRead])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  RESOLVED
  ARCHIVED
}
