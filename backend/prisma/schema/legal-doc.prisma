model LegalDocument {
  id    String            @id @default(uuid())
  type  LegalDocumentType
  title String

  versions LegalDocumentVersion[]

  activeVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type])
  @@index([type])
}

model LegalDocumentVersion {
  id         String @id @default(uuid())
  documentId String

  version String
  content String

  isActive Boolean @default(false)

  createdByUserId String?
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  acceptances UserLegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, isActive])
}

model UserLegalAcceptance {
  id        String @id @default(uuid())
  userId    String
  versionId String

  acceptedAt DateTime @default(now())

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId])
  @@index([userId])
  @@index([versionId])
  @@index([userId, acceptedAt])
}

enum LegalDocumentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  COOKIE_POLICY
  DATA_PROCESSING_AGREEMENT
}
