enum SubscriptionStatus {
  ACTIVE
  // Stripe could not collect the latest renewal payment, but may retry it.
  PAST_DUE
  CANCELLED
  EXPIRED
  PENDING
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String
  planId                   String

  // Stripe identity connects webhook events to this local subscription.
  stripeCustomerId         String?
  stripeSubscriptionId     String?            @unique

  // Local lifecycle and the exact billing period reported by Stripe.
  status                   SubscriptionStatus @default(PENDING)
  startDate                DateTime
  endDate                  DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?

  // Cancellation is scheduled at period end; access remains active until then.
  autoRenew                Boolean            @default(true)
  cancelAtPeriodEnd        Boolean            @default(false)

  // Latest invoice result is retained for support and payment auditing.
  lastStripeInvoiceId      String?
  lastPaidAt               DateTime?
  lastPaymentFailedAt      DateTime?
  lastPaymentFailureReason String?

  // Requested time and final cancellation time are intentionally separate.
  cancellationRequestedAt  DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user          User                      @relation(fields: [userId], references: [id])
  plan          SubscriptionPlan          @relation(fields: [planId], references: [id])
  creditBatches SubscriptionCreditBatch[]
  creditLogs    CreditLog[]               @relation("SubscriptionCreditLogs")
  referrals     UserReferral[]            @relation("ReferralSubscription")

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([stripeCustomerId])
}
