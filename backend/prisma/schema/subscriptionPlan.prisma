model SubscriptionPlan {
  id                    String                     @id @default(cuid())
  tier                  PlanTier
  name                  String
  description           String?
  price                 Decimal                    @db.Decimal(10, 2)
  // priceLabel      String?
  credit                Int
  visibility            SubscriptionPlanVisibility
  taskCreditsPerCycle   Int                        @default(1) @map("monthlyTaskCredits")
  maxTaskCreditCapacity Int                        @default(5)
  // currency        String          @default("GBP")
  billingInterval       BillingInterval            @default(MONTHLY)
  features              Json
  isActive              Boolean                    @default(true)

  maxWebsites              Int?
  additionalWebsitePrice   Decimal @default(0) @db.Decimal(10, 2)
  maxSimultaneousTasks     Int?
  visibilityCreditCapacity Int     @default(0)

  taskCreditUnitPrice       Decimal @default(0) @db.Decimal(10, 2)
  visibilityCreditUnitPrice Decimal @default(0) @db.Decimal(10, 2)

  referralEnabled               Boolean @default(false)
  badges                        Json?
  bulkTaskCreditDiscounts       Json?
  bulkVisibilityCreditDiscounts Json?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  subscriptions Subscription[]
}
