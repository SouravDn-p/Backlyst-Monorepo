model User {
  id                                     String            @id @default(uuid())
  name                                   String
  email                                  String            @unique
  referralCode                           String?           @unique
  isReferralEnabled                      Boolean           @default(true)
  role                                   UserRole          @default(USER)
  companyName                            String?
  companyWebsite                         String?
  companyIndustry                        String?
  businessType                           UserBusinessType?
  imageKey                               String?
  imageUrl                               String?
  country                                String?
  phoneNumber                            String?
  vatUid                                 String?
  password                               String?
  notificationTaskStatusUpdates          Boolean           @default(true)
  notificationCreditBalanceAlerts        Boolean           @default(true)
  notificationDisputeReviewNotifications Boolean           @default(true)
  notificationSystemAnnouncements        Boolean           @default(false)
  taskAutoAcceptTasks                    Boolean           @default(false)
  taskManualReviewRequired               Boolean           @default(true)

  lastPasswordChangeTime DateTime?
  registrationTime       DateTime?

  isVerified Boolean    @default(false)
  status     UserStatus @default(NOT_VERIFIED)
  isDeleted  Boolean    @default(false)

  suspendStart DateTime?
  suspendEnd   DateTime?

  punishmentReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditLogsAsActor      CreditLog[]             @relation("CreditLogActor")
  adminCreditAdjustments AdminCreditAdjustment[] @relation("AdminCreditAdjustments")
  referralApprovals      UserReferral[]          @relation("ReferralApprovedBy")
  referralRevocations    UserReferral[]          @relation("ReferralRevokedBy")
  adminReferralAuditLogs AdminReferralAuditLog[] @relation("AdminReferralAuditAdmin")
  referralProgramFreezes ReferralProgramConfig[] @relation("ReferralProgramFrozenBy")

  websiteWalletLockAudits WebsiteWalletLockAudit[] @relation("WebsiteWalletLockAdmin")

  sentMessages           Message[]               @relation("SenderMessages")
  receivedMessages       Message[]               @relation("ReceiverMessages")
  messageReports         MessageReport[]         @relation("MessageReporter")
  notificationsReceived  Notification[]          @relation("UserNotificationsReceived")
  notificationsActed     Notification[]          @relation("UserNotificationsActed")
  notificationPreference NotificationPreference?
  reviewedMessageReports MessageReport[]         @relation("MessageReportReviewer")

  requesterPlacementTasks     PlacementTask[]             @relation("RequesterPlacementTasks")
  selectedProviderTasks       PlacementTask[]             @relation("SelectedProviderTasks")
  placementApplications       PlacementApplication[]      @relation("ProviderPlacementApplications")
  taskFlowsAsRequester        TaskFlow[]                  @relation("TaskFlowRequester")
  taskFlowsAsProvider         TaskFlow[]                  @relation("TaskFlowProvider")
  taskFlowsAsActor            TaskFlow[]                  @relation("TaskFlowActor")
  requestedDeadlineExtensions TaskDeadlineExtension[]     @relation("RequestedDeadlineExtensions")
  respondedDeadlineExtensions TaskDeadlineExtension[]     @relation("RespondedDeadlineExtensions")
  requesterDirectRequestsSent DirectTaskRequest[]         @relation("RequesterDirectRequestsSent")
  providerDirectRequestsReceived DirectTaskRequest[]      @relation("ProviderDirectRequestsReceived")
  creditWallet                UserCreditWallet?
  creditLogs                  CreditLog[]                 @relation("UserCreditLogs")
  subscriptionCreditBatches   SubscriptionCreditBatch[]
  referralsSent               UserReferral[]              @relation("ReferrerUser")
  referralsReceived           UserReferral[]              @relation("ReferredUser")
  userGovernanceNotes         UserGovernanceNote[]        @relation("GovernanceNoteSubject")
  userGovernanceNotesAuthored UserGovernanceNote[]        @relation("GovernanceNoteAdmin")
  websites                    Website[]
  weeklyContributions         WebsiteWeeklyContribution[]
  verifiedPlacements          WebsiteVerifiedPlacement[]
  websiteActivityStreaks      WebsiteActivityStreak[]
  badges                      UserBadge[]
  rewardProfile               UserRewardProfile?
  rewardBenefits              UserRewardBenefit[]
  rewardLedgerEntries         RewardLedger[]
  rewardAuditLogsAuthored     RewardAuditLog[]            @relation("RewardAuditActor")
  rewardAuditLogsTargeted     RewardAuditLog[]            @relation("RewardAuditTargetUser")
  showcaseStats               UserShowcaseStats?
  ownedWebsiteShowcaseStats   WebsiteShowcaseStats[]
  generatedAnalyticsReports   AdminAnalyticsReport[]      @relation("AdminGeneratedAnalyticsReports")
  sessions                    Session[]
  subscriptions               Subscription[]
  governanceNotes             AdminUserGovernanceNote[]   @relation("AdminGovernanceNoteSubject")
  governanceNotesAuthored     AdminUserGovernanceNote[]   @relation("AdminGovernanceNoteAdmin")
  adminPermissionsAssigned    AdminPermission[]           @relation("AdminPermissionsAssignedBy")
  adminPermissions            AdminPermission[]           @relation("AdminPermissions")
  authorizationAuditLogs      AdminPermissionAuditLog[]    @relation("AdminAuthorizationAuditActor")
  authorizationAuditTargets   AdminPermissionAuditLog[]    @relation("AdminAuthorizationAuditTarget")

  websiteVerifications            WebsiteVerification[]    @relation("AdminUserManualReviews")
  authProviderAccounts            AuthProviderAccount[]
  userLegalAcceptances            UserLegalAcceptance[]
  legalDocumentVersions           LegalDocumentVersion[]
  websiteMatchingProfiles         WebsiteMatchingProfile[]
  providerOpportunityImpressions  OpportunityImpression[]  @relation("OpportunityProvider")
  requesterOpportunityImpressions OpportunityImpression[]  @relation("OpportunityRequester")
  marketplaceOverridesCreated     MarketplaceOverride[]    @relation("MarketplaceOverrideAdmin")
  blogPosts                       BlogPost[]
  publisher                       Publisher?
}

model UserGovernanceNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User @relation("GovernanceNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  admin User @relation("GovernanceNoteAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([adminId])
}

model AuthProviderAccount {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

enum AuthProvider {
  GOOGLE
}

model Publisher {
  id String @id @default(uuid())

  isVerified          Boolean  @default(true) //TODO:  TEMPORARY: defaults to true until verification system is introduced.
  // Will be switched to false once onboarding verification flow is implemented.
  nicheSpecialization String
  bio                 String
  tags                String[]

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUserGovernanceNote {
  id            String   @id @default(cuid())
  subjectUserId String
  adminUserId   String
  note          String
  createdAt     DateTime @default(now())

  subjectUser User @relation("AdminGovernanceNoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  adminUser   User @relation("AdminGovernanceNoteAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, createdAt])
  @@index([adminUserId, createdAt])
}

